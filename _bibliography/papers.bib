@inproceedings{FloreaTG17,
  author    = {Corneliu Florea and
               Cosmin Toca and
               Fabian Gieseke},
  title     = {Artistic Movement Recognition by Boosted Fusion of Color Structure
               and Topographic Description},
  booktitle = {2017 {IEEE} Winter Conference on Applications of Computer Vision,
               {WACV} 2017, Santa Rosa, CA, USA, March 24-31, 2017},
  pages     = {569--577},
